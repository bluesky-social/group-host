{
  "lexicon": 1,
  "id": "fyi.opensocial.getGroup",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a detailed view of a group: its profile and rules, and — for a viewer who may read the members space — how many are in it (listMembers names them), its roles, spaces and their read gates, plus the join queue for a viewer holding `admit`. Without auth, only the group's did and handle; with it, the viewer's standing and what their roles let them read. Every gate is the decision a space credential is minted on.",
      "parameters": {
        "type": "params",
        "required": ["group"],
        "properties": {
          "group": {
            "type": "string",
            "format": "did",
            "description": "The group DID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group"],
          "properties": {
            "group": {
              "type": "ref",
              "ref": "fyi.opensocial.defs#groupViewDetailed"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#roleView"
              }
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#roleBinding"
              }
            },
            "spaces": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#spaceView"
              }
            },
            "joinRequests": {
              "type": "array",
              "description": "Pending requests, newest first. Present only for a viewer holding `admit`.",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#joinRequest"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "GroupNotFound"
        }
      ]
    }
  }
}
