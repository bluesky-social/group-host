{
  "lexicon": 1,
  "id": "fyi.opensocial.getSubjectHistory",
  "defs": {
    "main": {
      "type": "query",
      "description": "Every event on one subject. Requires mod.read.",
      "parameters": {
        "type": "params",
        "required": ["group", "subject"],
        "properties": {
          "group": {
            "type": "string",
            "format": "did",
            "description": "The group DID. Every method is served by the group's host and authorized against that group's roles. Or the host's own DID, for its queue of what's shared with everyone: templates, their versions, and likes of them, for the host's moderators alone."
          },
          "subject": {
            "type": "string",
            "format": "uri",
            "description": "A record's at-uri, or an account's DID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subject", "events"],
          "properties": {
            "subject": {
              "type": "ref",
              "ref": "fyi.opensocial.defs#subjectView"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#eventView"
              }
            }
          }
        }
      }
    }
  }
}
