{
  "lexicon": 1,
  "id": "fyi.opensocial.invite",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "An invitation, written by the group in its own repo in the invitee's inbox (fyi.opensocial.invites), through com.atproto.space.*. Deleting it revokes it.",
      "record": {
        "type": "object",
        "required": ["createdAt"],
        "properties": {
          "message": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
