{
  "lexicon": 1,
  "id": "fyi.opensocial.conversation.pointer",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "Left in someone's inbox by whoever put them in a conversation, keyed by the conversation's key: how they find it.",
      "record": {
        "type": "object",
        "required": ["conversation", "createdAt"],
        "properties": {
          "conversation": {
            "type": "string",
            "format": "at-uri",
            "description": "The conversation's space."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
