{
  "lexicon": 1,
  "id": "fyi.opensocial.createInvite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Write an invite into someone's own inbox (fyi.opensocial.invites). Requires invite.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "invitee"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "invitee": {
              "type": "string",
              "format": "did"
            },
            "message": {
              "type": "string",
              "maxLength": 3000,
              "maxGraphemes": 300
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime",
              "description": "When the invite lapses, a time still to come."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "uri"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AlreadyMember",
          "description": "The invitee is a member already."
        }
      ]
    }
  }
}
