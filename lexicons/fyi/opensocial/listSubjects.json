{
  "lexicon": 1,
  "id": "fyi.opensocial.listSubjects",
  "defs": {
    "main": {
      "type": "query",
      "description": "The moderation queue. Requires mod.read.",
      "parameters": {
        "type": "params",
        "required": ["group"],
        "properties": {
          "group": {
            "type": "string",
            "format": "did",
            "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
          },
          "status": {
            "type": "string",
            "knownValues": ["open", "escalated", "resolved"]
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subjects"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "subjects": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#subjectView"
              }
            }
          }
        }
      }
    }
  }
}
