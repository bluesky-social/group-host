{
  "lexicon": 1,
  "id": "fyi.opensocial.manageSpaces",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions.",
      "title": "Group access",
      "detail": "Control who can see and change the group's info and member list, and which spaces are listed.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.meta",
          "authority": "self",
          "skey": "self",
          "collection": ["fyi.opensocial.access"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.members",
          "authority": "self",
          "skey": "self",
          "collection": ["fyi.opensocial.space", "fyi.opensocial.access"],
          "action": ["read", "create", "update", "delete"]
        }
      ]
    }
  }
}
