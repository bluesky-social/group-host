{
  "lexicon": 1,
  "id": "fyi.opensocial.basePermissions",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Groups",
      "detail": "See your groups and their sites, take part in them, act for groups where you hold a role, let apps sign in as them, share tabs from them with everyone as yourself, and like what others share",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.meta",
          "authority": "*",
          "skey": "self",
          "action": ["read"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.members",
          "authority": "*",
          "skey": "self",
          "collection": ["fyi.opensocial.acceptance"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.inbox",
          "authority": "*",
          "skey": "self",
          "collection": ["fyi.opensocial.invite"],
          "action": ["read", "create", "update", "delete"],
          "manage": ["create"]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["fyi.opensocial.template"],
          "action": ["create", "update"]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["fyi.opensocial.templateVersion"],
          "action": ["create"]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["fyi.opensocial.templateLike"],
          "action": ["create", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true,
          "lxm": [
            "fyi.opensocial.createGroup",
            "fyi.opensocial.provisionGroup",
            "fyi.opensocial.createSpace",
            "fyi.opensocial.getSuggestedSite",
            "fyi.opensocial.assignRoles",
            "fyi.opensocial.ejectMember",
            "fyi.opensocial.listGroups",
            "fyi.opensocial.getGroup",
            "fyi.opensocial.getActor",
            "fyi.opensocial.getGroupAuth",
            "fyi.opensocial.createInvite",
            "fyi.opensocial.requestJoin",
            "fyi.opensocial.listInvites",
            "fyi.opensocial.revokeInvite",
            "fyi.opensocial.getAuthorization",
            "fyi.opensocial.approveAuthorization",
            "fyi.opensocial.declineAuthorization",
            "fyi.opensocial.listSiteRecords",
            "fyi.opensocial.getSite",
            "fyi.opensocial.getSiteRecord",
            "fyi.opensocial.refreshRecords",
            "fyi.opensocial.getSpaceBlob",
            "fyi.opensocial.getActorInvites",
            "fyi.opensocial.getUnread",
            "fyi.opensocial.listNotifications",
            "fyi.opensocial.updateNotificationsSeen",
            "fyi.opensocial.getNotificationPreferences",
            "fyi.opensocial.putNotificationPreferences",
            "fyi.opensocial.describePush",
            "fyi.opensocial.registerPush",
            "fyi.opensocial.unregisterPush",
            "fyi.opensocial.declineInvite",
            "fyi.opensocial.updateProfile",
            "fyi.opensocial.putRole",
            "fyi.opensocial.deleteRole",
            "fyi.opensocial.putRule",
            "fyi.opensocial.deleteRule",
            "fyi.opensocial.applyLabel",
            "fyi.opensocial.negateLabel",
            "fyi.opensocial.listSubjects",
            "fyi.opensocial.getSubjectHistory",
            "fyi.opensocial.resolveSubject",
            "fyi.opensocial.getJoinRequest",
            "fyi.opensocial.listJoinRequests",
            "fyi.opensocial.admitMember",
            "fyi.opensocial.denyJoinRequest",
            "fyi.opensocial.cancelJoinRequest",
            "fyi.opensocial.leaveGroup",
            "fyi.opensocial.updateSpace",
            "fyi.opensocial.deleteSpace",
            "fyi.opensocial.uploadImage",
            "fyi.opensocial.listGroupTokens",
            "fyi.opensocial.revokeGroupToken",
            "fyi.opensocial.createAppPassword",
            "fyi.opensocial.listAppPasswords",
            "fyi.opensocial.revokeAppPassword",
            "fyi.opensocial.migratePrepare",
            "fyi.opensocial.migrateComplete",
            "fyi.opensocial.checkImport",
            "fyi.opensocial.importAccount",
            "fyi.opensocial.importAccountSpace",
            "fyi.opensocial.completeImport",
            "fyi.opensocial.deactivateGroup",
            "fyi.opensocial.activateGroup",
            "fyi.opensocial.deleteGroup",
            "fyi.opensocial.listRecoveryKeys",
            "fyi.opensocial.addRecoveryKey",
            "fyi.opensocial.removeRecoveryKey",
            "fyi.opensocial.checkGroupHandle",
            "fyi.opensocial.updateGroupHandle",
            "fyi.opensocial.listSpaceRecords",
            "fyi.opensocial.putSite",
            "fyi.opensocial.subscribeSpaces",
            "fyi.opensocial.uploadSiteFile",
            "fyi.opensocial.getBlobFields",
            "fyi.opensocial.listPeopleChannels",
            "fyi.opensocial.putPeopleChannel",
            "fyi.opensocial.deletePeopleChannel",
            "fyi.opensocial.createPeopleSpace",
            "fyi.opensocial.offerTab",
            "fyi.opensocial.listTabOffers",
            "fyi.opensocial.withdrawTabOffer",
            "fyi.opensocial.decideTabOffer",
            "fyi.opensocial.listRemovedTabs",
            "fyi.opensocial.restoreTab",
            "fyi.opensocial.getTabWriters",
            "fyi.opensocial.listDrafts",
            "fyi.opensocial.deleteDraft",
            "fyi.opensocial.listConnectedApps",
            "fyi.opensocial.watchConversation",
            "fyi.opensocial.getActorGroups",
            "fyi.opensocial.getAssistantRequest",
            "fyi.opensocial.approveAssistantRequest",
            "fyi.opensocial.declineAssistantRequest",
            "fyi.opensocial.getPageDraft",
            "fyi.opensocial.previewMethod",
            "fyi.opensocial.previewPublicPage",
            "fyi.opensocial.getSiteDraft",
            "fyi.opensocial.previewSiteDraft",
            "fyi.opensocial.publishSiteDraft",
            "fyi.opensocial.discardSiteDraft",
            "fyi.opensocial.draftFrontPage",
            "fyi.opensocial.undoSitePublish",
            "fyi.opensocial.deletePageDraft",
            "fyi.opensocial.revokeAssistant",
            "fyi.opensocial.callTab",
            "fyi.opensocial.shareTab",
            "fyi.opensocial.listTemplates",
            "fyi.opensocial.getTemplate",
            "fyi.opensocial.undoTabUpdate",
            "fyi.opensocial.takeBackVersion",
            "fyi.opensocial.getTabBundle",
            "fyi.opensocial.listTabShares",
            "fyi.opensocial.getTemplateUse",
            "fyi.opensocial.updateTemplateListing"
          ]
        }
      ]
    }
  }
}
