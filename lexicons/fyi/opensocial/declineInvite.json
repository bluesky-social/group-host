{
  "lexicon": 1,
  "id": "fyi.opensocial.declineInvite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Turn down the group's invite to the caller: it goes from the group's list and the caller's inbox. The group may invite them again.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            }
          }
        }
      },
      "errors": [
        {
          "name": "InviteNotFound"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
