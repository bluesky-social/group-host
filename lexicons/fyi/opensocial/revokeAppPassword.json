{
  "lexicon": 1,
  "id": "fyi.opensocial.revokeAppPassword",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Revoke one of the group's app passwords, and sign out every app signed in with it. Its maker may revoke their own; anyone else needs group.configure.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group", "name"],
          "properties": {
            "group": { "type": "string", "format": "did" },
            "name": { "type": "string" }
          }
        }
      },
      "errors": [{ "name": "NotFound" }, { "name": "Forbidden" }]
    }
  }
}
