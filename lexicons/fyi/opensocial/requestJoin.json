{
  "lexicon": 1,
  "id": "fyi.opensocial.requestJoin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ask to join. An invite the group has sent the caller, neither taken back nor past its expiresAt, admits them at once, whatever the group's join policy: the host redeems it from its own list, so no invite is named. No role required; authenticated as the requester.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "message": {
              "type": "string",
              "maxLength": 3000,
              "maxGraphemes": 300
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "knownValues": [
                "admitted",
                "pending"
              ]
            }
          }
        }
      },
      "errors": [
        {
          "name": "InviteRequired"
        },
        {
          "name": "AlreadyMember"
        }
      ]
    }
  }
}
