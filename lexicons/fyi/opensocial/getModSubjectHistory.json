{
  "lexicon": 1,
  "id": "fyi.opensocial.getModSubjectHistory",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a subject's moderation history, oldest first. Requires mod.read.",
      "parameters": {
        "type": "params",
        "required": [
          "group",
          "subject"
        ],
        "properties": {
          "group": {
            "type": "string",
            "format": "did",
            "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
          },
          "subject": {
            "type": "string",
            "format": "uri",
            "description": "An account DID or record URI."
          },
          "cid": {
            "type": "string",
            "format": "cid",
            "description": "If set, only this version of the record."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "events"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#moderationEvent"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidSubject",
          "description": "The subject isn't an account, a record in this group, or a record in a public repo."
        },
        {
          "name": "InvalidCursor",
          "description": "The cursor isn't one this host gave."
        }
      ]
    }
  }
}
