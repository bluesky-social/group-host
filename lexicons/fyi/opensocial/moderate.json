{
  "lexicon": 1,
  "id": "fyi.opensocial.moderate",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions.",
      "title": "Group moderation",
      "detail": "Review reports and moderation history, and label members.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.meta",
          "authority": "self",
          "skey": "self",
          "collection": ["com.atproto.label.label"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.members",
          "authority": "self",
          "skey": "self",
          "collection": ["com.atproto.label.label"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "aud": "*",
          "lxm": [
            "fyi.opensocial.listSubjects",
            "fyi.opensocial.getSubjectHistory",
            "fyi.opensocial.resolveSubject"
          ]
        }
      ]
    }
  }
}
