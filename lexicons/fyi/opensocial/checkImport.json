{
  "lexicon": 1,
  "id": "fyi.opensocial.checkImport",
  "defs": {
    "main": {
      "type": "query",
      "description": "What moving an account here would make of it, before anything moves (importAccount moves it so): its handle here, whether that's the one it has, and its address, this host's own name for it, where its site lives. A handle on a domain of the account's own that still names it comes along; one its old server gives out becomes the address. `refused` says why it can't have that address, as importAccount would.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "address": {
            "type": "string",
            "description": "The label of its address here, if not its handle's first label."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "handle", "address", "label", "keeps"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did"
            },
            "handle": {
              "type": "string",
              "format": "handle",
              "description": "Its handle once moved."
            },
            "address": {
              "type": "string",
              "format": "handle"
            },
            "label": {
              "type": "string"
            },
            "keeps": {
              "type": "boolean",
              "description": "Whether that's the handle it has now."
            },
            "from": {
              "type": "string",
              "description": "The handle it has now."
            },
            "refused": {
              "type": "unknown",
              "description": "{error, message}: InvalidHandle or HandleNotAvailable."
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotPlc"
        }
      ]
    }
  }
}
