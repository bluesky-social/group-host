{
  "lexicon": 1,
  "id": "fyi.opensocial.updateProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Replace the profile: name, description, join policy, where it meets, its topics and languages. Requires group.configure. Fields are inlined rather than referencing fyi.opensocial.profile, because a record def cannot be used as an input object, as createGroup's are.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "displayName"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "displayName": {
              "type": "string",
              "maxGraphemes": 64,
              "maxLength": 640
            },
            "description": {
              "type": "string",
              "maxGraphemes": 300,
              "maxLength": 3000
            },
            "joinPolicy": {
              "type": "string",
              "knownValues": [
                "fyi.opensocial.profile#open",
                "fyi.opensocial.profile#request",
                "fyi.opensocial.profile#invite"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The group's own site; left out, it is taken off."
            },
            "location": {
              "type": "union",
              "refs": [
                "community.lexicon.location.address",
                "community.lexicon.location.geo",
                "community.lexicon.location.fsq",
                "community.lexicon.location.hthree"
              ],
              "description": "Where it meets, if it meets somewhere: a town or city is enough."
            },
            "online": {
              "type": "boolean",
              "description": "It meets online, as well as or instead of somewhere."
            },
            "topics": {
              "type": "array",
              "maxLength": 10,
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#topicRef"
              },
              "description": "What it's about, a few words each, as the group puts it: climbing, choir, renters' union."
            },
            "languages": {
              "type": "array",
              "maxLength": 5,
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#languageRef"
              },
              "description": "The languages it uses, as BCP 47 tags: en, pl, sl."
            },
            "avatar": {
              "type": "blob",
              "accept": [
                "image/png",
                "image/jpeg"
              ],
              "maxSize": 1000000,
              "description": "The group's avatar, as returned by uploadImage. Omit to keep the current one; null to clear it."
            },
            "banner": {
              "type": "blob",
              "accept": [
                "image/png",
                "image/jpeg"
              ],
              "maxSize": 1000000,
              "description": "The group's banner, as returned by uploadImage. Omit to keep the current one; null to clear it."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "uri",
            "cid"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "cid": {
              "type": "string",
              "format": "cid"
            }
          }
        }
      }
    }
  }
}
