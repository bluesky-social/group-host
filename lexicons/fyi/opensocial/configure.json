{
  "lexicon": 1,
  "id": "fyi.opensocial.configure",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions.",
      "title": "Group settings",
      "detail": "Edit the group's profile, rules, and roles, and decide what each role can do.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.meta",
          "authority": "self",
          "skey": "self",
          "collection": ["fyi.opensocial.profile", "fyi.opensocial.rule", "fyi.opensocial.labeler"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.members",
          "authority": "self",
          "skey": "self",
          "collection": ["fyi.opensocial.role", "fyi.opensocial.permissions"],
          "action": ["read", "create", "update", "delete"]
        }
      ]
    }
  }
}
