{
  "lexicon": 1,
  "id": "fyi.opensocial.deleteRule",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a rule. Requires group.configure.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group", "rkey"],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "rkey": {
              "type": "string",
              "format": "record-key"
            }
          }
        }
      }
    }
  }
}
