{
  "lexicon": 1,
  "id": "fyi.opensocial.defs",
  "defs": {
    "joinRequest": {
      "type": "object",
      "description": "A request to join, waiting in the host.",
      "required": [
        "member",
        "createdAt"
      ],
      "properties": {
        "member": {
          "type": "string",
          "format": "did"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "message": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        },
        "actor": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView",
          "description": "Who is asking, as a view names them."
        }
      }
    },
    "modSubjectView": {
      "type": "object",
      "description": "A subject in the moderation queue.",
      "required": [
        "subject",
        "status",
        "createdAt",
        "updatedAt",
        "reportCount"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "format": "uri",
          "description": "An account DID or record URI."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "If set, a specific version of the record."
        },
        "actor": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView",
          "description": "The account the subject is, or whose record it is, as a view names them."
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "escalated",
            "resolved"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "updatedAt": {
          "type": "string",
          "format": "datetime"
        },
        "reportCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "moderationEvent": {
      "type": "object",
      "description": "One event in the host's private moderation history.",
      "required": [
        "id",
        "createdAt",
        "event"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "createdBy": {
          "type": "string",
          "format": "did",
          "description": "Hosts may withhold this to protect reporters and moderators."
        },
        "creator": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView",
          "description": "Who did it, as a view names them, when createdBy is given."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "The version of a record subject it is about, when it names one."
        },
        "event": {
          "type": "union",
          "refs": [
            "fyi.opensocial.defs#reportEvent",
            "fyi.opensocial.defs#statusEvent",
            "fyi.opensocial.defs#labelEvent",
            "fyi.opensocial.defs#ejectEvent"
          ]
        }
      }
    },
    "reportEvent": {
      "type": "object",
      "description": "Someone reported the subject; with reasonType appeal, the subject appealed.",
      "required": [
        "reasonType"
      ],
      "properties": {
        "reasonType": {
          "type": "string",
          "knownValues": [
            "spam",
            "violation",
            "misleading",
            "nsfw",
            "rude",
            "other",
            "appeal"
          ]
        },
        "reason": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        },
        "rule": {
          "type": "string",
          "format": "at-uri",
          "description": "A rule in the group's meta space."
        }
      }
    },
    "statusEvent": {
      "type": "object",
      "description": "A moderator set the subject's status, optionally with a note.",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "escalated",
            "resolved"
          ]
        },
        "note": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        }
      }
    },
    "labelEvent": {
      "type": "object",
      "description": "A label record (com.atproto.label.record) was written as the group, or deleted, which takes it back.",
      "required": [
        "uri",
        "val"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The label record, as it was written."
        },
        "val": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deleted": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ejectEvent": {
      "type": "object",
      "description": "The subject's membership was deleted.",
      "properties": {}
    }
  }
}
