{
  "lexicon": 1,
  "id": "fyi.opensocial.declineAuthorization",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Decline an app's pending request to sign in as a group. Returns the URL to send the browser back to the app with, carrying access_denied.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requestUri"
          ],
          "properties": {
            "requestUri": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "redirectUrl"
          ],
          "properties": {
            "redirectUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "errors": [
        {
          "name": "ExpiredRequest"
        }
      ]
    }
  }
}
