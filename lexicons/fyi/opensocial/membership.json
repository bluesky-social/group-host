{
  "lexicon": 1,
  "id": "fyi.opensocial.membership",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "Grants a member their roles. Written by the group authority; the record key is the member's DID.",
      "record": {
        "type": "object",
        "required": ["member", "roles", "createdAt"],
        "properties": {
          "member": {
            "type": "string",
            "format": "did"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "description": "A role id: the record key of a fyi.opensocial.role record."
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
