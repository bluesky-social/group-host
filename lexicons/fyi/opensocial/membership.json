{
  "lexicon": 1,
  "id": "fyi.opensocial.membership",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "Grants a member their roles. Written by the group authority; the record key is the member's DID.",
      "record": {
        "type": "object",
        "required": [
          "member",
          "roles",
          "createdAt"
        ],
        "properties": {
          "member": {
            "type": "string",
            "format": "did"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "fyi.opensocial.defs#roleRef"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
