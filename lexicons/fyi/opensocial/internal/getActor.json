{
  "lexicon": 1,
  "id": "fyi.opensocial.internal.getActor",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a person as a view names them. Requires auth. Answers for the caller themselves, or for anyone the host shows \u2014 a member of a group it runs, or someone asking to join one.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": {
            "type": "string",
            "format": "did",
            "description": "DID of the person."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView"
        }
      },
      "errors": [
        {
          "name": "ActorNotFound"
        }
      ]
    }
  }
}
