{
  "lexicon": 1,
  "id": "fyi.opensocial.internal.revokeGroupToken",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Revoke one act-as session for the group DID. Requires group.configure.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "tokenId"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did"
            },
            "tokenId": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
