{
  "lexicon": 1,
  "id": "fyi.opensocial.internal.listConnectedApps",
  "defs": {
    "main": {
      "type": "query",
      "description": "The AI apps, MCP clients, you've connected to the group to act as you there, the most lately used first: each by the name it gave, to disconnect with revokeConnectedApp.",
      "parameters": {
        "type": "params",
        "required": [
          "group"
        ],
        "properties": {
          "group": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "apps"
          ],
          "properties": {
            "apps": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#appView"
              }
            }
          }
        }
      }
    },
    "appView": {
      "type": "object",
      "required": [
        "clientId",
        "name",
        "connectedAt",
        "usedAt"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "connectedAt": {
          "type": "string",
          "format": "datetime"
        },
        "usedAt": {
          "type": "string",
          "format": "datetime"
        },
        "clientId": {
          "type": "string"
        }
      }
    }
  }
}
