{
  "lexicon": 1,
  "id": "fyi.opensocial.internal.listGroupTokens",
  "defs": {
    "main": {
      "type": "query",
      "description": "The OAuth sessions issued by this host for the group DID (apps acting as the group), plus recent activity. Requires group.configure.",
      "parameters": {
        "type": "params",
        "required": [
          "group"
        ],
        "properties": {
          "group": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "sessions",
            "activity"
          ],
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#sessionView"
              }
            },
            "activity": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#activityView"
              }
            }
          }
        }
      }
    },
    "sessionView": {
      "type": "object",
      "description": "A session an app holds as the group.",
      "required": [
        "tokenId",
        "clientId",
        "member",
        "source",
        "grantedAt"
      ],
      "properties": {
        "tokenId": {
          "type": "string"
        },
        "clientId": {
          "type": "string",
          "description": "The app's OAuth client id."
        },
        "member": {
          "type": "string",
          "format": "did",
          "description": "Who let it in."
        },
        "actor": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView",
          "description": "Who let it in, with their handle where it can be read."
        },
        "role": {
          "type": "string",
          "description": "The role it was given, if one."
        },
        "source": {
          "type": "string",
          "knownValues": [
            "oauth",
            "getGroupAuth",
            "appPassword"
          ]
        },
        "scope": {
          "type": "string"
        },
        "grantedAt": {
          "type": "string",
          "format": "datetime"
        },
        "lastUsedAt": {
          "type": "string",
          "format": "datetime"
        },
        "expiresAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "activityView": {
      "type": "object",
      "description": "Something an app did as the group.",
      "required": [
        "member",
        "action",
        "at"
      ],
      "properties": {
        "member": {
          "type": "string",
          "format": "did",
          "description": "Who let the app in."
        },
        "actor": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView",
          "description": "Who let the app in, with their handle where it can be read."
        },
        "clientId": {
          "type": "string",
          "description": "The app's OAuth client id."
        },
        "action": {
          "type": "string",
          "description": "The method it called, or the record it wrote."
        },
        "write": {
          "type": "ref",
          "ref": "#writeView",
          "description": "The record it wrote, in parts, when it was a write."
        },
        "subject": {
          "type": "ref",
          "ref": "fyi.opensocial.internal.defs#actorView",
          "description": "Whom the write is about, with their handle where it can be read: whose DID keys the record (a membership), or whose inbox it was written in (an invite)."
        },
        "at": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "writeView": {
      "type": "object",
      "description": "A record an app wrote as the group.",
      "required": [
        "operation",
        "collection",
        "rkey"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "knownValues": [
            "create",
            "update",
            "delete"
          ]
        },
        "collection": {
          "type": "string",
          "format": "nsid"
        },
        "rkey": {
          "type": "string",
          "description": "The record's key."
        },
        "space": {
          "type": "string",
          "description": "The space it was written in, by its at:// address; none for the group's public repo."
        }
      }
    }
  }
}
