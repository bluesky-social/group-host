{
  "lexicon": 1,
  "id": "fyi.opensocial.internal.listRecoveryKeys",
  "defs": {
    "main": {
      "type": "query",
      "description": "The rotation keys on the group's did:plc that matter: stewards' recovery keys and this host's own, highest priority first. A recovery key outranks the host's, so its holder can undo what the host does to the identity and move the group without it. Requires group.configure.",
      "parameters": {
        "type": "params",
        "required": ["group"],
        "properties": {
          "group": {
            "type": "string",
            "format": "did",
            "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["keys", "hostHolds", "max"],
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#key"
              }
            },
            "hostHolds": {
              "type": "boolean",
              "description": "Whether this host still holds a rotation key, and so can change them."
            },
            "max": {
              "type": "integer",
              "description": "How many recovery keys a group can have."
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotController"
        }
      ]
    },
    "key": {
      "type": "object",
      "required": ["key", "holder"],
      "properties": {
        "key": {
          "type": "string"
        },
        "holder": {
          "type": "string",
          "knownValues": ["host", "steward"]
        },
        "addedBy": {
          "type": "string",
          "format": "did"
        },
        "addedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
