{
  "lexicon": 1,
  "id": "fyi.opensocial.createSpace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a modality space to the group. Requires space.create.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group", "type", "readableBy"],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "type": {
              "type": "string",
              "format": "nsid"
            },
            "skey": {
              "type": "string",
              "format": "record-key"
            },
            "name": {
              "type": "string"
            },
            "readableBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "credentialScopes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.access#roleScopes"
              },
              "description": "Which collections each role may write as the group DID in this space. Copied into the space's access record."
            },
            "writableBy": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Who may write into the space in their own name: role ids, or 'public' for anyone signed in. Absent is any member."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "space-ref"
            }
          }
        }
      }
    }
  }
}
