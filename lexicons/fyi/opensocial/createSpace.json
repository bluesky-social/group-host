{
  "lexicon": 1,
  "id": "fyi.opensocial.createSpace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a space under the group with its access record and, unless index is false, an index entry. Requires space.create.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "type",
            "access"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "type": {
              "type": "string",
              "format": "nsid"
            },
            "skey": {
              "type": "string",
              "format": "record-key",
              "description": "Omit to generate a TID."
            },
            "access": {
              "type": "ref",
              "ref": "fyi.opensocial.defs#accessConfig"
            },
            "index": {
              "type": "boolean",
              "default": true,
              "description": "Add the space to the group's index."
            },
            "name": {
              "type": "string",
              "maxLength": 640,
              "maxGraphemes": 64,
              "description": "What the group calls it, kept in its index entry."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "space",
            "access"
          ],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            },
            "access": {
              "type": "ref",
              "ref": "com.atproto.repo.strongRef"
            },
            "index": {
              "type": "ref",
              "ref": "com.atproto.repo.strongRef",
              "description": "Present when the space was indexed."
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceAlreadyExists",
          "description": "A space with this type and skey already exists."
        },
        {
          "name": "ReservedSpace",
          "description": "The meta and members spaces can't be created or deleted."
        },
        {
          "name": "UnknownRole",
          "description": "A grant names a role that doesn't exist."
        },
        {
          "name": "InvalidScope",
          "description": "A grant isn't a space scope."
        }
      ]
    }
  }
}
