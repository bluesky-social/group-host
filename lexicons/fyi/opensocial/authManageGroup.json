{
  "lexicon": 1,
  "id": "fyi.opensocial.authManageGroup",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions. Limited to what the authorizing user's roles grant.",
      "title": "Group administration",
      "detail": "Manage everything in the group's info and member list, including its roles and what each role can do.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.meta",
          "authority": "self",
          "skey": "self",
          "collection": [
            "fyi.opensocial.profile",
            "fyi.opensocial.rule",
            "fyi.opensocial.labeler",
            "com.atproto.label.record"
          ],
          "action": [
            "read",
            "create",
            "update",
            "delete"
          ],
          "manage": [
            "update"
          ]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.members",
          "authority": "self",
          "skey": "self",
          "collection": [
            "fyi.opensocial.role",
            "fyi.opensocial.membership",
            "com.atproto.label.record"
          ],
          "action": [
            "read",
            "create",
            "update",
            "delete"
          ],
          "manage": [
            "update"
          ]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "fyi.opensocial.invites",
          "authority": "*",
          "skey": "self",
          "collection": [
            "fyi.opensocial.invite"
          ],
          "action": [
            "read_self",
            "create",
            "update",
            "delete"
          ]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "aud": "*",
          "lxm": [
            "fyi.opensocial.listJoinRequests",
            "fyi.opensocial.denyJoinRequest",
            "fyi.opensocial.listInvites",
            "fyi.opensocial.listModSubjects",
            "fyi.opensocial.getModSubjectHistory",
            "fyi.opensocial.getModSubjectBlob",
            "fyi.opensocial.resolveModSubject"
          ]
        }
      ]
    }
  }
}
