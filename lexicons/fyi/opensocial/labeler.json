{
  "lexicon": 1,
  "id": "fyi.opensocial.labeler",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "The group as a moderation service: the label values it applies and what it accepts reports about. Written by the group into the meta space.",
      "record": {
        "type": "object",
        "required": [
          "policies",
          "createdAt"
        ],
        "properties": {
          "policies": {
            "type": "ref",
            "ref": "fyi.opensocial.defs#labelerPolicies"
          },
          "reasonTypes": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "com.atproto.moderation.defs#reasonType"
            },
            "description": "Accepted report reasons. Omit to accept all."
          },
          "subjectTypes": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "com.atproto.moderation.defs#subjectType"
            },
            "description": "Accepted report subject types. Omit to accept all."
          },
          "subjectCollections": {
            "type": "array",
            "description": "Record types that can be reported. Omit to accept all.",
            "items": {
              "type": "string",
              "format": "nsid"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
