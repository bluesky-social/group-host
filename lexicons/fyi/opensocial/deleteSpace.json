{
  "lexicon": 1,
  "id": "fyi.opensocial.deleteSpace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a space. Requires space.delete. Refuses on the meta and members spaces.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "space"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "space": {
              "type": "string",
              "format": "space-ref"
            }
          }
        }
      },
      "errors": [
        {
          "name": "WellKnownSpace"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
