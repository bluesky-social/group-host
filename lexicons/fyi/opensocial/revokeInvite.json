{
  "lexicon": 1,
  "id": "fyi.opensocial.revokeInvite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Retract an outstanding invite. Requires invite.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "uri"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "uri": {
              "type": "string",
              "format": "at-uri"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "errors": [
        {
          "name": "InviteNotFound",
          "description": "No invite to that account waits."
        }
      ]
    }
  }
}
