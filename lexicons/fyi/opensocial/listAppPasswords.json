{
  "lexicon": 1,
  "id": "fyi.opensocial.listAppPasswords",
  "defs": {
    "main": {
      "type": "query",
      "description": "The group's app passwords, never the passwords themselves: every one for whoever has group.configure, and their own for whoever may make them.",
      "parameters": {
        "type": "params",
        "required": ["group"],
        "properties": {
          "group": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["passwords"],
          "properties": {
            "passwords": {
              "type": "array",
              "items": { "type": "ref", "ref": "#appPassword" }
            }
          }
        }
      },
      "errors": [{ "name": "Forbidden" }]
    },
    "appPassword": {
      "type": "object",
      "required": ["name", "member", "privileged", "createdAt"],
      "properties": {
        "name": { "type": "string" },
        "member": {
          "type": "string",
          "format": "did",
          "description": "Who made it, and whose it stays."
        },
        "privileged": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "datetime" },
        "lastUsedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When an app last used a session signed in with it, while one lasts."
        }
      }
    }
  }
}
