{
  "lexicon": 1,
  "id": "fyi.opensocial.listGroups",
  "defs": {
    "main": {
      "type": "query",
      "description": "Host-level: the groups hosted here. With auth, the profiles anyone signed in may read; without it, each group's did and handle alone.",
      "parameters": {
        "type": "params",
        "properties": {}
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["groups"],
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fyi.opensocial.defs#groupView"
              }
            }
          }
        }
      }
    }
  }
}
