{
  "lexicon": 1,
  "id": "fyi.opensocial.resolveSubject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve or escalate a subject, optionally with a note. Requires mod.resolve.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "subject",
            "action"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "subject": {
              "type": "string",
              "format": "uri",
              "description": "A record's at-uri, or an account's DID."
            },
            "action": {
              "type": "string",
              "knownValues": [
                "resolve",
                "escalate",
                "note"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 3000,
              "maxGraphemes": 300
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
