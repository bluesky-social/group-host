{
  "lexicon": 1,
  "id": "fyi.opensocial.resolveSubject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve or escalate a subject, optionally with a note. Repeating the current status adds the note. Requires mod.resolve.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "subject",
            "status"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did",
              "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
            },
            "subject": {
              "type": "union",
              "refs": [
                "fyi.opensocial.defs#accountSubject",
                "fyi.opensocial.defs#recordSubject"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "resolved",
                "escalated"
              ]
            },
            "note": {
              "type": "string",
              "maxGraphemes": 2000,
              "maxLength": 20000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "fyi.opensocial.defs#subjectView"
        }
      },
      "errors": [
        {
          "name": "InvalidSubject",
          "description": "The subject isn't an account or record in this group."
        },
        {
          "name": "SubjectNotFound",
          "description": "The subject has never been reported."
        }
      ]
    }
  }
}
