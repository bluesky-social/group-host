{
  "lexicon": 1,
  "id": "org.atgrp.internal.getActorInvites",
  "defs": {
    "main": {
      "type": "query",
      "description": "The caller's own invites still waiting, from the groups on this host, newest first: for an app, which can't read the caller's inbox. With group, that group's only.",
      "parameters": {
        "type": "params",
        "properties": {
          "group": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invites"],
          "properties": {
            "invites": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#actorInvite"
              }
            }
          }
        }
      }
    },
    "actorInvite": {
      "type": "object",
      "required": ["group", "createdAt"],
      "properties": {
        "group": {
          "type": "ref",
          "ref": "org.atgrp.internal.defs#groupViewBasic"
        },
        "message": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
