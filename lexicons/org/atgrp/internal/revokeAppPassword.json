{
  "lexicon": 1,
  "id": "org.atgrp.internal.revokeAppPassword",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Revoke one of the group's app passwords, and sign out every app signed in with it. Its maker may revoke their own; anyone else needs group.configure.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "name"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did"
            },
            "name": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        },
        {
          "name": "Forbidden"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
