{
  "lexicon": 1,
  "id": "org.atgrp.internal.revokeConnectedApp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Disconnect an AI app you connected to the group (listConnectedApps): its tokens end, and it acts as you there no more.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "group",
            "clientId"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did"
            },
            "clientId": {
              "type": "string",
              "maxLength": 2048,
              "description": "The app's client ID, as listConnectedApps gives it."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
