{
  "lexicon": 1,
  "id": "org.atgrp.internal.migrateActivate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Destination host: activate the migrated account once the PLC operation is live.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["spaces"],
          "properties": {
            "spaces": {
              "type": "integer",
              "description": "Spaces whose members' records are being read afresh."
            }
          }
        }
      }
    }
  }
}
