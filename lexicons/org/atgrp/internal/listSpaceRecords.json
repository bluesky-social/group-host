{
  "lexicon": 1,
  "id": "org.atgrp.internal.listSpaceRecords",
  "defs": {
    "main": {
      "type": "query",
      "description": "Records in one of a group's content spaces, from the host's index of it: one collection or every collection, newest first, a page at a time. Only for someone signed in whom the space's policy lets read, checked on every call, a space open to anyone included.",
      "parameters": {
        "type": "params",
        "required": ["group", "space"],
        "properties": {
          "group": {
            "type": "string",
            "format": "did"
          },
          "space": {
            "type": "string",
            "description": "The space's URI."
          },
          "collection": {
            "type": "string",
            "format": "nsid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "From the last page: continues with older records."
          },
          "field": {
            "type": "string",
            "maxLength": 128,
            "description": "Only records whose field (a name or a dotted path, like subject.uri) equals `equals`."
          },
          "equals": {
            "type": "string",
            "maxLength": 2048
          },
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "One record in the space, by its URI."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#spaceRecord"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "No group here by that DID, a space not one of the group's, or a `uri` that is no record of the space."
        },
        {
          "name": "NotAuthorized",
          "description": "A space the caller may not read, by its policy."
        }
      ]
    },
    "spaceRecord": {
      "type": "object",
      "required": ["uri", "cid", "repo", "value", "createdAt"],
      "properties": {
        "uri": {
          "type": "string"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "repo": {
          "type": "string",
          "format": "did"
        },
        "value": {
          "type": "unknown"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
