{
  "lexicon": 1,
  "id": "org.atgrp.space",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "An entry in the group's space index, in the members space. The host maintains it as spaces are created, deleted, or unlisted, and rejects direct writes.",
      "record": {
        "type": "object",
        "required": [
          "space",
          "createdAt"
        ],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
