{
  "lexicon": 1,
  "id": "org.atgrp.listJoinRequests",
  "defs": {
    "main": {
      "type": "query",
      "description": "The pending-requests queue. Requires admit.",
      "parameters": {
        "type": "params",
        "required": ["group"],
        "properties": {
          "group": {
            "type": "string",
            "format": "did",
            "description": "The group DID. Every method is served by the group's host and authorized against that group's roles."
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["requests"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "requests": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "org.atgrp.defs#joinRequest"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidCursor",
          "description": "The cursor isn't one this host gave."
        }
      ]
    }
  }
}
