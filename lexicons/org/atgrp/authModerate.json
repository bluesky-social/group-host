{
  "lexicon": 1,
  "id": "org.atgrp.authModerate",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions. Limited to what the authorizing user's roles grant.",
      "title": "Group moderation",
      "detail": "Approve, invite, label, and remove members, change their roles, and review reports.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "org.atgrp.meta",
          "authority": "self",
          "skey": "self",
          "collection": [
            "com.atproto.label.record"
          ],
          "action": [
            "read",
            "create",
            "update",
            "delete"
          ]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "org.atgrp.members",
          "authority": "self",
          "skey": "self",
          "collection": [
            "org.atgrp.membership",
            "com.atproto.label.record"
          ],
          "action": [
            "read",
            "create",
            "update",
            "delete"
          ]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "org.atgrp.invites",
          "authority": "*",
          "skey": "self",
          "collection": [
            "org.atgrp.invite"
          ],
          "action": [
            "read_self",
            "create",
            "update",
            "delete"
          ]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "aud": "*",
          "lxm": [
            "org.atgrp.listJoinRequests",
            "org.atgrp.denyJoinRequest",
            "org.atgrp.internal.listInvites",
            "org.atgrp.listModSubjects",
            "org.atgrp.getModSubjectHistory",
            "org.atgrp.internal.getModSubjectBlob",
            "org.atgrp.resolveModSubject"
          ]
        }
      ]
    }
  }
}
