{
  "name": "group-host-web",
  "private": true,
  "description": "The console: the pages where people start and run their groups, drawn from the group host's XRPC methods",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "lex": "lex build --lexicons ../lexicons --out src/lib/lexicons --clear --import-ext .ts",
    "dev": "npm run lex && vite dev",
    "build": "npm run lex && vite build",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
    "prepare": "svelte-kit sync || echo ''",
    "check": "npm run lex && npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@atproto/lex": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/oauth-scopes": "0.0.0-spaces-alpha-20261117141222",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/paraglide-js-svelte": "^1.0.5",
    "@inlang/plugin-message-format": "^4.5.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.19.2",
    "oxfmt": "0.76.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@atproto/lex": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-builder": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-cbor": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-client": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-data": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-document": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-installer": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-json": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-resolver": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-schema": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-server": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lexicon": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/oauth-client": "0.0.0-spaces-alpha-20261117141222"
  }
}
