# The group-host repository this example sits in.
repo := justfile_directory() / "../.."

# Once: the spaces alpha's dev-env into .deps/, then the console's, the
# SDK's, the site's and the harness's packages (harness/bootstrap.sh).
bootstrap:
    harness/bootstrap.sh

# The group host, its command and its console (with the page it serves
# around a site), built from this repository as it is now.
host:
    cd {{repo}} && rustup run stable cargo build -p group-host -p opensocial
    cd {{repo}}/web && npm run build

# The site, a Svelte app, built into site/dist, which the seed publishes.
site:
    cd site && npm run build

# The site's checks: svelte-check, failing on any warning, and its
# components' layers (harness/layers.mjs).
check:
    cd site && npm run check
    node harness/layers.mjs

# The site to use yourself, at https://kicker.places.localtest.me behind
# portless, over a world of its own with the place made in it (harness/dev.mjs).
dev: host site
    node harness/dev.mjs

# The site used as people use it, signed in with OAuth at the PDS's own
# page, in Chromium (harness/e2e/flows.spec.mjs).
e2e *args: host site
    cd harness && npx playwright test -c e2e/playwright.config.mjs {{args}}

# The rooms as pictures in target/look, signed in (harness/look.mjs).
look *args: host site
    node harness/look.mjs {{args}}
