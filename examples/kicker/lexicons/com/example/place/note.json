{
  "lexicon": 1,
  "id": "com.example.place.note",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A note pinned to a place's board, in its author's repo in the place's room.",
      "record": {
        "type": "object",
        "required": [
          "text",
          "createdAt"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "maxGraphemes": 1000
          },
          "kind": {
            "type": "string",
            "knownValues": [
              "notice",
              "ask",
              "offer"
            ],
            "description": "notice: something to know. ask: something wanted. offer: something given or lent. A notice, unless it says."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
