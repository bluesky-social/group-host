{
  "lexicon": 1,
  "id": "com.example.place.event",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "An event at a place, in the repo of the host who wrote it, in the place's calendar.",
      "record": {
        "type": "object",
        "required": [
          "name",
          "startsAt",
          "createdAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "description": {
            "type": "string",
            "maxLength": 30000,
            "maxGraphemes": 3000
          },
          "startsAt": {
            "type": "string",
            "format": "datetime",
            "description": "When it starts."
          },
          "endsAt": {
            "type": "string",
            "format": "datetime",
            "description": "When it ends, after it starts."
          },
          "cancelled": {
            "type": "boolean",
            "description": "Whether its host called it off."
          },
          "image": {
            "type": "blob",
            "accept": ["image/*"],
            "maxSize": 1000000,
            "description": "Its poster, or a photo of it, in the host's own repo."
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300,
            "description": "What the picture shows, for whoever can't see it."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
