{
  "name": "@opensocial/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Apps and sites on a group host: a group's own methods, and its spaces read whole as lex-space reads them, kept and read on",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lex": "lex build --lexicons ../../lexicons --out src/lexicons --clear --import-ext .ts",
    "check": "npm run lex && tsc --noEmit",
    "test": "npm run lex && vitest run"
  },
  "dependencies": {
    "@atproto/lex": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-space": "0.0.0-spaces-alpha-20261117141222"
  },
  "devDependencies": {
    "@atproto/lex-builder": "0.0.0-spaces-alpha-20261117141222",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
